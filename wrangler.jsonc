{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manga-platform",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manga-db",
      "database_id": "75abec13-2158-4b2f-aea8-51e6d4728b84",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "manga-images"
    }
  ],
  "vars": {
    "MAX_UPLOAD_MB": "10",
    "FIREBASE_PROJECT_ID": ""
  }
}
